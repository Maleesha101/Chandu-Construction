# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=site_cash_flow
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
